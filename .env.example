# Local app mode
NODE_ENV=development
NEXT_PUBLIC_TEST_MODE=false

# Public Supabase config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Solana and cNFT minting
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TFN_MINT_SECRET_KEY=base64-encoded-server-wallet-secret-key
TFN_MERKLE_TREE=your-merkle-tree-public-key

# Tooth Fairy Network feature flags and admin gates
NEXT_PUBLIC_TFN_ENABLE_AI_ENHANCE=true
NEXT_PUBLIC_TFN_FIAT_ONRAMP_ENABLED=false
TFN_ADMIN_SECRET=your-admin-secret
TOOTHFAIRY_ADMIN_SECRET=your-admin-secret
CRON_SECRET=your-cron-secret
DRIP_CRON_SECRET=your-drip-cron-secret

# Google auth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# AI and media providers
FAL_KEY=your-fal-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
TANDA_ELEVENLABS_VOICE_ID=your-tanda-elevenlabs-voice-id
GOOGLE_API_KEY=your-google-generative-ai-api-key

# Email
RESEND_API_KEY=your-resend-api-key

# MoonPay on-ramp
MOONPAY_API_KEY=your-moonpay-api-key
MOONPAY_PUBLIC_KEY=your-moonpay-public-key
MOONPAY_SECRET_KEY=your-moonpay-secret-key
MOONPAY_ENVIRONMENT=sandbox
MOONPAY_BUY_BASE_URL=
MOONPAY_REDIRECT_URL=http://localhost:3000/toothfairy/app

# Optional/legacy integrations
CROSSMINT_SERVER_KEY=your-crossmint-server-key
NOTION_API_KEY=your-notion-api-key
NOTION_DATABASE_ID=your-notion-database-id
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
STUDIO_PASSWORD=your-studio-password
VOICE_PIN=your-voice-pin
API_URL=http://localhost:3000

# Vercel injects these in hosted environments
VERCEL_URL=
VERCEL_BRANCH_URL=

